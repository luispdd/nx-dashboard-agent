    "affected": "nx affected -t lint test build",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "seed": "nx run agent-service:seed",
    "etl": "nx run dashboard-api:etl",
    "eval": "nx run agent-service:eval",
    "export:openapi": "nx run dashboard-api:export-openapi",
    "generate:contracts": "nx run shared-contracts:generate-contracts"
