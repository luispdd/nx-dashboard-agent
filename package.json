{
  "name": "nx-dashboard-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "nx run-many -t serve --outputStyle=stream",
    "serve": "nx run-many -t serve --outputStyle=stream",
    "serve:all": "nx run-many -t serve --outputStyle=stream",
    "serve:shell": "nx serve dashboard-shell",
    "serve:api": "nx serve dashboard-api",
    "serve:chat": "nx serve chat-mfe",
    "serve:agent": "nx serve agent-service",
