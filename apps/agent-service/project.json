{
  "name": "agent-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/agent-service/src",
  "tags": [
    "type:app",
    "scope:agent"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run uvicorn src.agent_service:app --reload --port 8000",
        "cwd": "apps/agent-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/agent-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/agent-service"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run seed",
        "cwd": "apps/agent-service"
      }
    },
    "etl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run etl",
        "cwd": "apps/agent-service"
      }
    }
  }
}
