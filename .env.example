# ==============================================================================
# IoT Dashboard + Data Agent — Centralized Workspace Environment Configuration
# ==============================================================================
# Copy this file to .env at workspace root: cp .env.example .env

# --- LLM Provider Configuration ---
# Target OpenAI-compatible server endpoint.
# Local development on host: http://127.0.0.1:8888/v1
# Containerized setup reaching host LLM runner: http://host.docker.internal:8888/v1
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_MODEL=unsloth/Qwen3.5-4B-GGUF
LLM_API_KEY=

# --- Service Host Bindings & Ports ---
# Loopback by default (127.0.0.1) prevents unintended exposure on local networks.
API_HOST=127.0.0.1
API_PORT=3000
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
WEB_SHELL_PORT=4200
WEB_REMOTE_PORT=4204

# --- Network & Security Allowlists ---
# Comma-separated list of browser origins permitted to communicate with backend APIs
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4204,http://127.0.0.1:4204
# Comma-separated list of Host header values permitted (protects against DNS rebinding)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000

# --- Service URLs & Networking ---
# MCP server endpoint(s) for agent tool discovery (comma-separated)
MCP_SERVER_URLS=http://localhost:3000/api/mcp

# URL for the FastAPI Agent Service (used by chat-mfe client)
VITE_AGENT_API_URL=http://localhost:8000

# --- Database & Storage ---
# Path to the derived read-only SQLite database relative to workspace root
DERIVED_DB_PATH=data/derived/measurements.db

# --- Security & Secret Encryption ---
# Symmetric AES-256 key used to encrypt/decrypt stored API keys in runtime-config.json.
# Generate a secure 32-byte hex key:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
CONFIG_ENCRYPTION_KEY=
# Set to true only in local development to allow a fallback dev key if CONFIG_ENCRYPTION_KEY is unset
ALLOW_INSECURE_DEV_KEY=false

# --- API Documentation ---
# Toggle Swagger UI availability at /api/docs (default: true in development, false in production)
SWAGGER_ENABLED=true

# --- Agent Chat Limits ---
# Maximum chat stream requests per client IP per minute
CHAT_RATE_LIMIT_PER_MINUTE=20
# Maximum concurrent SSE streams per client IP
CHAT_MAX_CONCURRENT_STREAMS=3
# Maximum prompt characters allowed per chat message
CHAT_MAX_MESSAGE_CHARS=4000
# Maximum active sessions before LRU idle session eviction
CHAT_MAX_SESSIONS=100
# Session inactivity TTL in seconds
CHAT_SESSION_TTL_SECONDS=3600

# --- MCP Server Configuration ---
# Read-only Model Context Protocol server over Streamable HTTP at /api/mcp
MCP_ENABLED=true
MCP_MAX_POINTS_PER_CALL=500
# Optional bearer token for MCP server authentication
# MCP_AUTH_TOKEN=
# Note: MCP requests use the shared ALLOWED_ORIGINS and ALLOWED_HOSTS defined above.
# MCP_ALLOWED_ORIGINS=

# --- Host Volume Permissions ---
# UID and GID for container volume mounts on Linux hosts
UID=1000
GID=1000
