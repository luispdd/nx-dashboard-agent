# ==============================================================================
# Web Host — Multi-stage Dockerfile (Angular Shell + React MFE + Nginx)
# ==============================================================================

# --- Stage 1: Build frontends ---
FROM node:22-slim AS builder
WORKDIR /app

# Install build dependencies and Bun package manager
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && \
    npm install -g bun@1.4.0 && \
    rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock tsconfig.base.json nx.json ./
RUN bun install --frozen-lockfile

COPY apps apps
COPY libs libs

# Build Angular Shell SPA and React Chat MFE
RUN bun nx build dashboard-shell
RUN bun nx build chat-mfe

# --- Stage 2: Nginx Static Server ---
FROM nginx:1.27-alpine AS runner

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist/apps/dashboard-shell/browser /usr/share/nginx/html/shell
COPY --from=builder /app/dist/apps/chat-mfe /usr/share/nginx/html/chat

EXPOSE 4200 4204

CMD ["nginx", "-g", "daemon off;"]
