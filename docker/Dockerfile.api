# ==============================================================================
# Dashboard API — Multi-stage Dockerfile
# ==============================================================================

# --- Stage 1: Build NestJS application ---
FROM node:22-slim AS builder
WORKDIR /app

# Install build dependencies and Bun package manager
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && \
    npm install -g bun@1.4.0 && \
    rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock tsconfig.base.json nx.json ./
RUN bun install --frozen-lockfile

COPY apps/dashboard-api apps/dashboard-api
COPY libs libs

RUN bun nx build dashboard-api

# --- Stage 2: Production runtime image ---
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV DERIVED_DB_PATH=data/derived/measurements.db

# Install build tools to compile native better-sqlite3 addon if prebuilt binary not matched
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

# Install production dependencies only
COPY --from=builder /app/dist/apps/dashboard-api/package.json ./package.json
RUN npm install --omit=dev && \
    apt-get purge -y python3 make g++ && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Copy built application artifact
COPY --from=builder /app/dist/apps/dashboard-api/main.js ./dist/apps/dashboard-api/main.js

# Ensure data directories exist for volume mounts and permissions are set
RUN mkdir -p data/migrations data/derived && chown -R node:node /app

EXPOSE 3000

CMD ["node", "dist/apps/dashboard-api/main.js"]
